# GEMINI_API_KEY: Required for Gemini AI API calls (used as fallback for Listing Type classification).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPER_API_KEY: Optional fallback Serper.dev API key if not set via Admin Settings UI.
SERPER_API_KEY=""

# DATAFORSEO_LOGIN & DATAFORSEO_PASSWORD: Optional fallback DataForSEO credentials if not set via Admin Settings UI.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# JWT_SECRET: Secret key used to sign session tokens and encrypt server-side credentials.
JWT_SECRET="citation-discovery-secret-key-change-in-prod"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

